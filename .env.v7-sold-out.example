# Absolute path on persistent local disk outside repository. Use same file on restart.
HOF_TESTNET_SOLD_OUT_JOURNAL=
# Leave empty. Later, separate approvals required per phase:
# AUTHORIZE_TESTNET_FUND or AUTHORIZE_TESTNET_MINT
HOF_TESTNET_SOLD_OUT_CONFIRM=
HOF_ENABLE_SERVICE=NO
