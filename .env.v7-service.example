# SERVER ONLY. Copy to a protected file outside the public site/repository.
# Disabled by default. Starting this process may submit TESTNET transactions.
HOF_ENABLE_SERVICE=NO
HOF_SERVICE_MODE=testnetMockUSDC
HOF_RPC_URL=https://rpc.testnet.chain.robinhood.com
HOF_TRUSTED_LEADERBOARDS=
GENESIS_SALE_ADDRESS=
PROJECT_WALLET=
# Absolute paths to existing externally provisioned files, permissions0600.
# Admission/settlement signer and limited-fund relayer MUST be different wallets.
# Neither may be owner/admin, team or project/treasury.
HOF_ADMISSION_KEY_FILE=
HOF_RELAYER_KEY_FILE=
# RSA3072 PKCS8 PEM files named <keyId-without-0x>.pem; keep every pending race key.
HOF_DECRYPTION_KEY_DIRECTORY=
# Persistent local disk, permissions0700. Never ephemeral serverless storage.
HOF_SERVICE_DIRECTORY=
HOF_SERVICE_PORT=9000
# >=32 characters, provision externally; shared only with the Next server proxy.
HOF_SIGNED_INGRESS_TOKEN=
# Next SERVER environment separately: HOF_SIGNED_SERVICE_URL=http://127.0.0.1:9000
# All workers using either signing wallet must share /tmp/hof-relayer-locks.
# Single host/PID namespace; replicas with independent disks are unsupported.

# Verified canonical RaceCreated block; required for each registered race.
# Do not use the system deployment anchor, current head, or first-vote block.
HOF_RACE_ADDRESS=
HOF_RACE_DEPLOYMENT_BLOCK=
# Multiple races: JSON map of actual race address -> actual creation block.
# Must retain entries for all registered races across restarts/seasons.
HOF_RACE_DEPLOYMENT_BLOCKS=
