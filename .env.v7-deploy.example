# V7 Robinhood Chain Testnet deployment/operations parameters.
# Copy to a local .env file. Never commit real private keys.

DEPLOYER_PRIVATE_KEY=

# Existing USDC-compatible ERC-20 contract used for the V7 testnet sale.
HOF_USDC_ADDRESS=

# Explicit wallets. These are deployment parameters, not Tokenomics changes.
TEAM_RESERVE_WALLET=
AUDIT_WALLET=
PROJECT_WALLET=

# V7 leaves the final mint deadline to finalize. Supply it explicitly as Unix seconds.
MINT_DEADLINE_UNIX=

# Unrevealed metadata URI until the separate reveal/randomization design is finalized.
GENESIS_PLACEHOLDER_URI=

# Either a non-zero treasury address or the literal DEPLOYED_REWARDS.
PRIZE_POOL_DESTINATION=

# Race deployment.
GENESIS_ADDRESS=
RACE_OPENS_AT_UNIX=

# Race registration / season operations.
RACE_ADDRESS=
COMMUNITY_SEASON_ADDRESS=
HOF_LEADERBOARD_ADDRESS=

# Community season reward payout. HOF-side payout remains intentionally unavailable
# until V7's final HOF beneficiary mechanism is decided.
SEASON_REWARDS_ADDRESS=
SEASON_NUMBER=
