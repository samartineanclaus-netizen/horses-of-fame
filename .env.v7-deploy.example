# V7 Robinhood Chain Testnet deployment parameters.
# Copy to a local .env file. Never commit real private keys.

DEPLOYER_PRIVATE_KEY=

# Existing USDC-compatible ERC-20 contract used for the V7 testnet sale.
HOF_USDC_ADDRESS=

# Explicit project-controlled/operational wallets. These are deployment parameters,
# not changes to Tokenomics V7.
TEAM_RESERVE_WALLET=
AUDIT_WALLET=
PROJECT_WALLET=

# V7 leaves the final mint deadline to finalize. Supply it explicitly as Unix seconds.
MINT_DEADLINE_UNIX=

# Unrevealed metadata URI used until the separate reveal/randomization design is finalized.
GENESIS_PLACEHOLDER_URI=

# Either a non-zero treasury address or the literal DEPLOYED_REWARDS.
# DEPLOYED_REWARDS explicitly chooses the newly deployed HOFSeasonRewards contract.
PRIZE_POOL_DESTINATION=

# Used only by scripts/deploy-v7-race.js after the system contracts exist.
GENESIS_ADDRESS=
RACE_OPENS_AT_UNIX=
