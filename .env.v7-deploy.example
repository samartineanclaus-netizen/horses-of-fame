# Canonical V7 TESTNET only. Empty by design; never commit real private keys.
DEPLOYER_PRIVATE_KEY=
HOF_OWNER_ADDRESS=
HOF_ADMISSION_SIGNER=
HOF_RELAYER_ADDRESS=
TEAM_RESERVE_WALLET=
PROJECT_WALLET=
AUDIT_WALLET=
HOF_USDC_ADDRESS=
# TESTNET ONLY: recompute immediately before deployment: latest chain timestamp + 604800.
# The canonical remote entrypoint recomputes this; preflight requires a fresh value.
MINT_DEADLINE_UNIX=
# Full HTTPS /genesis/unrevealed.json URL on the verified public testnet site.
# Leave blank until JSON and image are hosted and verified. Never use metadata/1.json.
GENESIS_PLACEHOLDER_URI=
# Race creation through the immutable Sponsored Race factory.
HOF_TRUSTED_LEADERBOARDS=
GENESIS_SALE_ADDRESS=
RACE_OPENS_AT_UNIX=
# Public RSA3072 SPKI DER hex, NOT a private/decryption key.
HOF_RACE_PUBLIC_KEY=
# Server-only proxy/service channel. Generate locally, never NEXT_PUBLIC.
HOF_SIGNED_INGRESS_TOKEN=
HOF_SIGNED_SERVICE_URL=

# Only approved payment mode. No production USDC configured.
HOF_TOKEN_MODE=testnetMockUSDC
HOF_RPC_URL=https://rpc.testnet.chain.robinhood.com
HOF_MIN_DEPLOYER_WEI=
# Explicit minimum gas balance for preflight, chosen after local gas estimates.
