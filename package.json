{
  "name": "horses-of-fame-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "compile:contracts": "hardhat compile",
    "test:contracts": "hardhat test",
    "check:deploy-scripts": "node --check scripts/deploy-v7-system.js && node --check scripts/deploy-v7-race.js && node --check scripts/register-v7-race.js && node --check scripts/finalize-v7-season.js && node --check scripts/pay-v7-community-season.js",
    "deploy:v7:testnet": "hardhat run scripts/deploy-v7-system.js --network robinhoodTestnet",
    "deploy:v7:race:testnet": "hardhat run scripts/deploy-v7-race.js --network robinhoodTestnet",
    "ops:v7:register-race:testnet": "hardhat run scripts/register-v7-race.js --network robinhoodTestnet",
    "ops:v7:finalize-season:testnet": "hardhat run scripts/finalize-v7-season.js --network robinhoodTestnet",
    "ops:v7:pay-community-season:testnet": "hardhat run scripts/pay-v7-community-season.js --network robinhoodTestnet"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "wagmi": "^2.16.9",
    "viem": "^2.37.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "hardhat": "^2.26.3",
    "typescript": "^5"
  }
}
