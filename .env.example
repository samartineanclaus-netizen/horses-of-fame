# Horses of Fame public testnet contract configuration.
# Fill these only with deployed Robinhood Chain Testnet addresses.
# Never place private keys in NEXT_PUBLIC variables.

NEXT_PUBLIC_HOF_GENESIS_CONTRACT=
NEXT_PUBLIC_HOF_GENESIS_SALE_CONTRACT=
NEXT_PUBLIC_HOF_USDC_CONTRACT=
# Legacy read-only fields; do not configure these as Sponsored Voting addresses.
NEXT_PUBLIC_HOF_RACE_VOTING_CONTRACT=
NEXT_PUBLIC_HOF_COMMUNITY_SEASON_CONTRACT=
NEXT_PUBLIC_HOF_LEADERBOARD_CONTRACT=
NEXT_PUBLIC_HOF_SEASON_REWARDS_CONTRACT=

# Owner-trusted path: use reviewed deployed addresses, never the legacy race ABI.
NEXT_PUBLIC_HOF_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_HOF_CHAIN_ID=46630
NEXT_PUBLIC_HOF_TRUSTED_RACE=
NEXT_PUBLIC_HOF_TRUSTED_LEADERBOARDS=
# Server-only admission service URL; no private keys belong in this file.
HOF_ADMISSION_URL=

# TEST ONLY / NO VALUE. Explicitly select Sponsored Voting.
NEXT_PUBLIC_HOF_TOKEN_MODE=testnetMockUSDC
NEXT_PUBLIC_HOF_SIGNED_VOTING=enabled
NEXT_PUBLIC_HOF_RACE_DEPLOYMENT_BLOCK=
HOF_SIGNED_SERVICE_URL=
HOF_SIGNED_INGRESS_TOKEN=
